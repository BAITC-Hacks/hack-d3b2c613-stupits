# Настройки ИИ-советника. Этот файл-шаблон попадает в git — НЕ вписывайте сюда ключ!
# run.bat / run.sh копируют его в .env; настоящий ключ храните только в .env (он в .gitignore).
# Без ключа и модели приложение работает целиком, а советник показывает офлайн-разбор
# по данным движка. Значения пишите без кавычек.

# Ключ провайдера: OpenAI (sk-...) или NVIDIA (nvapi-...).
OPENAI_API_KEY=
# Модель с поддержкой Chat Completions и function calling.
OPENAI_MODEL=
# Базовый URL OpenAI-совместимого API. Пусто — OpenAI.
# Для NVIDIA: https://integrate.api.nvidia.com/v1
OPENAI_BASE_URL=
